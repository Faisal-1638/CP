#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;
    while(t--)
    {
        int n;
        cin >> n;

        vector<int> v(n);
        for(int i = 0; i < n; i++)
            cin >> v[i];

        bool oddGroup = true;
        for(int i = 2; i < n; i += 2)
        {
            if((v[i] % 2) != (v[0] % 2))
            {
                oddGroup = false;
                break;
            }
        }

        bool evenGroup = true;
        for(int i = 3; i < n; i += 2)
        {
            if((v[i] % 2) != (v[1] % 2))
            {
                evenGroup = false;
                break;
            }
        }

        if(oddGroup && evenGroup)
            cout << "YES\n";
        else
            cout << "NO\n";
    }
}